<?xml version="1.0" encoding="utf-8"?>
<org.mozilla.focus.browser.cursor.TvCursorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/tvToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#252830"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <!-- Address/search on top. Its width tracks the toolbar button row below. -->
            <LinearLayout
                android:id="@+id/tvAddressRow"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/tv_omnibox_inset_background"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <org.mozilla.focus.widget.InlineAutocompleteEditText
                    android:id="@+id/tvAddressInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:drawableStart="@drawable/ic_search"
                    android:drawablePadding="8dp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:hint="@string/tv_address_search_hint"
                    android:imeOptions="actionGo|flagNoExtractUi|flagNoFullscreen"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp"
                    android:selectAllOnFocus="true"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#BCC5D2"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/tvAddressGoButton"
                    android:layout_width="68dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/tv_omnibox_go_background"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/tv_go"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Home, Bookmark, Downloads, History, Settings, then Back/Forward/Refresh. -->
            <LinearLayout
                android:id="@+id/tvToolbarButtonRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/tvHomeButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/tv_home"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/tvBookmarkButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/tv_bookmark"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/tvDownloadsButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/tv_downloads"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/tvHistoryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/tv_history"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/tvSettingsButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/menu_settings"
                    android:textAllCaps="false" />

                <ImageButton
                    android:id="@+id/tvBackButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/tv_toolbar_icon_background"
                    android:contentDescription="@string/tv_back"
                    android:src="@drawable/ic_back"
                    android:scaleType="centerInside"
                    android:padding="12dp"
                    android:tint="@color/tv_toolbar_icon_tint" />

                <ImageButton
                    android:id="@+id/tvForwardButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/tv_toolbar_icon_background"
                    android:contentDescription="@string/tv_forward"
                    android:src="@drawable/ic_forward"
                    android:scaleType="centerInside"
                    android:padding="12dp"
                    android:tint="@color/tv_toolbar_icon_tint" />

                <ImageButton
                    android:id="@+id/tvRefreshButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/tv_toolbar_icon_background"
                    android:contentDescription="@string/tv_refresh"
                    android:src="@drawable/ic_refresh"
                    android:scaleType="centerInside"
                    android:padding="12dp"
                    android:tint="@color/tv_toolbar_icon_tint" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</org.mozilla.focus.browser.cursor.TvCursorLayout>
