<?xml version="1.0" encoding="utf-8"?>
<org.mozilla.focus.browser.cursor.TvCursorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/tvToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="@drawable/tv_modern_toolbar_background"
            android:theme="@style/TvModernToolbarTheme"
            android:elevation="6dp">

            <LinearLayout
                android:id="@+id/tvAddressRow"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:addStatesFromChildren="true"
                android:padding="4dp"
                android:background="@drawable/tv_modern_address_background">

                <androidx.appcompat.widget.AppCompatAutoCompleteTextView
                    android:id="@+id/tvAddressInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:drawableStart="@drawable/ic_search"
                    android:drawableTint="#FFFFFF"
                    android:drawablePadding="12dp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:hint="@string/tv_address_search_hint"
                    android:imeOptions="actionGo|flagNoExtractUi|flagNoFullscreen"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:selectAllOnFocus="true"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#D4D4D4"
                    android:textColorHighlight="#777777"
                    android:textSize="18sp"
                    android:nextFocusRight="@+id/tvAddressGoButton"
                    android:nextFocusDown="@+id/tvHomeButton" />

                <org.mozilla.tv.browser.TvToolbarButton
                    android:id="@+id/tvAddressGoButton"
                    style="@style/TvModernGoButton"
                    android:text="@string/tv_go"
                    android:nextFocusLeft="@id/tvAddressInput"
                    android:nextFocusDown="@+id/tvRefreshButton" />
            </LinearLayout>

            <!-- The existing width listener uses this ID on the scroll viewport. -->
            <HorizontalScrollView
                android:id="@+id/tvToolbarButtonRow"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:fillViewport="true"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:focusable="false">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <org.mozilla.tv.browser.TvToolbarButton
                        android:id="@+id/tvHomeButton"
                        style="@style/TvModernButton"
                        android:drawableStart="@drawable/tv_modern_ic_home"
                        android:text="@string/tv_home"
                        android:nextFocusUp="@id/tvAddressInput" />

                    <org.mozilla.tv.browser.TvToolbarButton
                        android:id="@+id/tvBookmarkButton"
                        style="@style/TvModernButton"
                        android:layout_marginStart="8dp"
                        android:drawableStart="@drawable/tv_modern_ic_bookmark"
                        android:text="@string/tv_bookmark"
                        android:nextFocusUp="@id/tvAddressInput" />

                    <org.mozilla.tv.browser.TvToolbarButton
                        android:id="@+id/tvDownloadsButton"
                        style="@style/TvModernButton"
                        android:layout_marginStart="8dp"
                        android:drawableStart="@drawable/tv_modern_ic_downloads"
                        android:text="@string/tv_downloads"
                        android:nextFocusUp="@id/tvAddressInput" />

                    <org.mozilla.tv.browser.TvToolbarButton
                        android:id="@+id/tvHistoryButton"
                        style="@style/TvModernButton"
                        android:layout_marginStart="8dp"
                        android:drawableStart="@drawable/tv_modern_ic_history"
                        android:text="@string/tv_history"
                        android:nextFocusUp="@id/tvAddressInput" />

                    <org.mozilla.tv.browser.TvToolbarButton
                        android:id="@+id/tvSettingsButton"
                        style="@style/TvModernButton"
                        android:layout_marginStart="8dp"
                        android:drawableStart="@drawable/tv_modern_ic_settings"
                        android:text="@string/menu_settings"
                        android:nextFocusUp="@id/tvAddressInput" />

                    <Space
                        android:layout_width="12dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <org.mozilla.tv.browser.TvToolbarImageButton
                        android:id="@+id/tvBackButton"
                        style="@style/TvModernIconButton"
                        android:contentDescription="@string/tv_back"
                        android:src="@drawable/ic_back"
                        android:nextFocusUp="@id/tvAddressInput" />

                    <org.mozilla.tv.browser.TvToolbarImageButton
                        android:id="@+id/tvForwardButton"
                        style="@style/TvModernIconButton"
                        android:contentDescription="@string/tv_forward"
                        android:src="@drawable/ic_forward"
                        android:nextFocusUp="@id/tvAddressInput" />

                    <org.mozilla.tv.browser.TvToolbarImageButton
                        android:id="@+id/tvRefreshButton"
                        style="@style/TvModernIconButton"
                        android:contentDescription="@string/tv_refresh"
                        android:src="@drawable/ic_refresh"
                        android:nextFocusUp="@id/tvAddressGoButton" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</org.mozilla.focus.browser.cursor.TvCursorLayout>
