<?xml version="1.0" encoding="utf-8"?>
<org.mozilla.focus.browser.cursor.TvCursorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/tvToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#252830"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

            <Button
                android:id="@+id/tvHomeButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/tv_home"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/tvBookmarkButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/tv_bookmark"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/tvMenuButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/tv_menu"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/tvDownloadsButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/tv_downloads"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/tvHistoryButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/tv_history"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/tvSettingsButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/menu_settings"
                android:textAllCaps="false" />
            </LinearLayout>

            <!-- One omnibox on the persistent toolbar, including the home screen. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="10dp">

                <org.mozilla.focus.widget.InlineAutocompleteEditText
                    android:id="@+id/tvAddressInput"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/tv_omnibox_background"
                    android:drawableStart="@drawable/ic_search"
                    android:drawablePadding="12dp"
                    android:gravity="center_vertical"
                    android:hint="@string/tv_address_search_hint"
                    android:imeOptions="actionGo|flagNoExtractUi|flagNoFullscreen"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp"
                    android:selectAllOnFocus="true"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#BCC5D2"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/tvAddressGoButton"
                    android:layout_width="88dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="10dp"
                    android:text="@string/tv_go"
                    android:textAllCaps="false" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</org.mozilla.focus.browser.cursor.TvCursorLayout>
